"""
Script 39 - Cross-catalog tension test for STAM's derived adjustment

SUPERSEDED (post-G7/G8): this script frames Model-A as predicting the
catalog ΔM tensions LCDM produces. Under the two-tables framing
committed in 2026-05-09 memory feedback, Model-A does not define
itself as the explanation for LCDM's anomalies. The current two-tables
analog is:
  scripts/G8h_v3_catalog_self_consistency.py
which fits per-catalog ΔM under each framework independently and reports
each framework's own cross-catalog spread, with no cross-framework
explanatory claims. The math here uses V_1 cosmology (also superseded
by V_3 numerical KG per G8a-c). Preserved as historical record; do
not use in current STAM analyses.

Sean's hypothesis (2026-05-07):
  LCDM fits Pantheon+, Union3, AND DES individually well, BUT each catalog
  ends up with a slightly different best-fit nuisance offset DeltaM. That
  catalog-to-catalog DeltaM tension is well-known in the SN cosmology
  literature (DES-Y5 vs Pantheon+, etc.). If data actually follows STAM,
  each catalog's best-fit DeltaM under LCDM equals
        DeltaM_cat = <- Delta_mu_STAM-LCDM(z)>_cat   (weighted average over the catalog's z-distribution)
  STAM should therefore PREDICT the inter-catalog DeltaM disagreement
  exactly, with the magnitude of the cross-catalog tension matching the
  STAM-vs-LCDM Delta_mu shape integrated over each catalog's z window.

Test:
  1. Fit LCDM to each catalog independently -> DeltaM_LCDM_cat
  2. Fit STAM  to each catalog independently -> DeltaM_STAM_cat
  3. Compute the cross-catalog difference  Delta(DeltaM_LCDM)  observed.
  4. Compute STAM's prediction for the same cross-catalog difference, by
     evaluating  -<Delta_mu_STAM-LCDM(z)>  weighted by each catalog's
     z-distribution.
  5. If the predicted and observed cross-catalog tensions match, STAM's
     photon-A interpretation is the structural origin of the disagreement.
"""

from __future__ import annotations
import numpy as np
import pandas as pd
import matplotlib.pyplot as plt
from pathlib import Path

# ==================================================================
# Cosmological setup (same as scripts 36-38)
# ==================================================================
C_KMS = 299792.458
H0_KMS_MPC = 67.4

A0 = 0.026514
OMEGA_M = 0.315
OMEGA_R = 9.2e-5
BETA_TILDE = OMEGA_M * (1.0 - A0)**2

def A_eq(a):
    return 1.0 - (1.0 - A0) * a**1.5
def Y_pot(a):
    return BETA_TILDE / (1.0 - A_eq(a))
def K_kin(a):
    return (3.0/8.0) * (1.0 - A0)**2 * a**3
def h2_STAM_raw(a):
    return (OMEGA_M * a**-3 + OMEGA_R * a**-4 + Y_pot(a)) / (1.0 - K_kin(a))
H2_TODAY_STAM = h2_STAM_raw(1.0)
def h2_STAM(a):
    return h2_STAM_raw(a) / H2_TODAY_STAM
def h2_LCDM(a):
    return OMEGA_M * a**-3 + OMEGA_R * a**-4 + (1.0 - OMEGA_M - OMEGA_R)

def cumtrapz0(y, x):
    dx = np.diff(x); midy = 0.5*(y[1:]+y[:-1])
    return np.concatenate([[0.0], np.cumsum(midy*dx)])

def mu_predict(z_obs, h2_func, n_grid=8000, z_max=None):
    if z_max is None:
        z_max = max(np.max(z_obs)*1.05, 0.01)
    z_grid = np.linspace(0.0, z_max, n_grid)
    a_grid = 1.0/(1.0+z_grid)
    inv_h = 1.0/np.sqrt(h2_func(a_grid))
    DC_grid = (C_KMS/H0_KMS_MPC)*cumtrapz0(inv_h, z_grid)
    DC_obs = np.interp(z_obs, z_grid, DC_grid)
    dL_obs = (1.0+z_obs)*DC_obs
    return 5.0*np.log10(dL_obs)+25.0

def fit_offset_chi2(z_obs, mu_obs, mu_err, h2_func):
    mu_model = mu_predict(z_obs, h2_func)
    w = 1.0/mu_err**2
    DeltaM = np.sum(w*(mu_obs-mu_model))/np.sum(w)
    resid = mu_obs - (mu_model + DeltaM)
    chi2 = np.sum(w*resid**2)
    return {
        'chi2': chi2,
        'dof': len(z_obs)-1,
        'chi2_per_dof': chi2/(len(z_obs)-1),
        'DeltaM': DeltaM,
        'mu_model': mu_model,
        'resid': resid,
        'z': z_obs, 'mu': mu_obs, 'mu_err': mu_err,
    }

# ==================================================================
# Load all three catalogs
# ==================================================================
DATA = Path('data')

# Pantheon+
pantheon = pd.read_csv(DATA/'pantheon.csv')
mP = (pantheon['IS_CALIBRATOR']==0) & (pantheon['zCMB']>0.01)
pantheon_cosmo = pantheon[mP].copy()
zP = pantheon_cosmo['zCMB'].values
muP = pantheon_cosmo['MU_SH0ES'].values
muPe = pantheon_cosmo['MU_SH0ES_ERR_DIAG'].values

# Union3 (binned)
union3 = pd.read_csv(DATA/'union3_bins.csv')
zU = union3['z'].values
muU = union3['mb'].values
muUe = np.full_like(muU, 0.05)

# DES-Y5
des = pd.read_csv(DATA/'des.csv')
mD = (des['zCMB']>0.01)
des_cosmo = des[mD].copy()
zD = des_cosmo['zCMB'].values
muD = des_cosmo['MU'].values
muDe = des_cosmo['MUERR'].values

print("=" * 72)
print("Cross-catalog tension test  |  STAM photon-A signature")
print("=" * 72)
print(f"Pantheon+ : N = {len(zP):4d},  median z = {np.median(zP):.3f},  z range [{zP.min():.3f}, {zP.max():.3f}]")
print(f"Union3    : N = {len(zU):4d},  median z = {np.median(zU):.3f},  z range [{zU.min():.3f}, {zU.max():.3f}]")
print(f"DES-Y5    : N = {len(zD):4d},  median z = {np.median(zD):.3f},  z range [{zD.min():.3f}, {zD.max():.3f}]")
print()

# ==================================================================
# Independent fits
# ==================================================================
fits_LCDM = {
    'Pantheon+': fit_offset_chi2(zP, muP, muPe, h2_LCDM),
    'Union3'   : fit_offset_chi2(zU, muU, muUe, h2_LCDM),
    'DES-Y5'   : fit_offset_chi2(zD, muD, muDe, h2_LCDM),
}
fits_STAM = {
    'Pantheon+': fit_offset_chi2(zP, muP, muPe, h2_STAM),
    'Union3'   : fit_offset_chi2(zU, muU, muUe, h2_STAM),
    'DES-Y5'   : fit_offset_chi2(zD, muD, muDe, h2_STAM),
}

print("Independent best-fit DeltaM (offset) per catalog:")
print(f"{'catalog':<12} {'LCDM DeltaM':>14} {'STAM DeltaM':>14} "
      f"{'LCDM chi2/dof':>14} {'STAM chi2/dof':>14}")
for cat in ('Pantheon+', 'Union3', 'DES-Y5'):
    rL = fits_LCDM[cat]; rS = fits_STAM[cat]
    print(f"{cat:<12} {rL['DeltaM']:>+14.4f} {rS['DeltaM']:>+14.4f} "
          f"{rL['chi2_per_dof']:>14.4f} {rS['chi2_per_dof']:>14.4f}")

# ==================================================================
# Inter-catalog DeltaM tensions (observed, under LCDM)
# ==================================================================
print()
print("OBSERVED inter-catalog DeltaM tension (under LCDM fit):")
pairs = [('Pantheon+', 'Union3'), ('Pantheon+', 'DES-Y5'), ('Union3', 'DES-Y5')]
obs_tensions = {}
for a, b in pairs:
    diff = fits_LCDM[a]['DeltaM'] - fits_LCDM[b]['DeltaM']
    obs_tensions[(a,b)] = diff
    print(f"  DeltaM({a}) - DeltaM({b}) = {diff:+.4f} mag")

# ==================================================================
# STAM PREDICTION for inter-catalog DeltaM tension
# Each catalog's best-fit DeltaM_LCDM = -<Delta_mu_STAM-LCDM(z)>_cat
#   where the average is weighted by the catalog's z-distribution & errors.
# So predicted catalog tension is:
#   prediction(a,b) = -<Delta_mu>_a - (-<Delta_mu>_b) = -(<Delta_mu>_a - <Delta_mu>_b)
# ==================================================================
def Delta_mu_STAM_minus_LCDM(z):
    mu_L = mu_predict(z, h2_LCDM)
    mu_S = mu_predict(z, h2_STAM)
    return mu_L - mu_S   # this is "LCDM - STAM" = -(STAM - LCDM)

def weighted_mean_Delta_mu(z, mu_err):
    w = 1.0/mu_err**2
    dmu = Delta_mu_STAM_minus_LCDM(z)
    return np.sum(w*dmu)/np.sum(w)

mean_dmu = {
    'Pantheon+': weighted_mean_Delta_mu(zP, muPe),
    'Union3'   : weighted_mean_Delta_mu(zU, muUe),
    'DES-Y5'   : weighted_mean_Delta_mu(zD, muDe),
}
print()
print("STAM prediction: <Delta_mu_LCDM-STAM(z)>_cat per catalog:")
for cat, v in mean_dmu.items():
    print(f"  <Delta_mu>_{cat:<10} = {v:+.4f} mag")

print()
print("PREDICTED inter-catalog DeltaM tension:")
print("(if data follows STAM, each LCDM-fit ends up with DeltaM = -<Delta_mu_LCDM-STAM(z)>")
print("so cross-cat tension =  -(<Delta_mu>_a - <Delta_mu>_b))")

pred_tensions = {}
for a, b in pairs:
    pred = -(mean_dmu[a] - mean_dmu[b])
    pred_tensions[(a,b)] = pred
    print(f"  pred[DeltaM({a}) - DeltaM({b})] = {pred:+.4f} mag")

# ==================================================================
# Comparison: observed vs predicted cross-catalog tensions
# ==================================================================
print()
print("=" * 72)
print("HEAD-TO-HEAD: cross-catalog tension (observed vs STAM-predicted)")
print("=" * 72)
print(f"{'pair':<28} {'observed':>10} {'predicted':>10} {'ratio':>8} {'match':>8}")
for a, b in pairs:
    obs = obs_tensions[(a,b)]
    pred = pred_tensions[(a,b)]
    if abs(pred) > 1e-6:
        ratio = obs/pred
    else:
        ratio = float('nan')
    sign_match = "yes" if (obs*pred > 0) else "NO"
    print(f"  {a:<10} - {b:<10}    {obs:>+10.4f} {pred:>+10.4f} {ratio:>8.3f} {sign_match:>8}")

# ==================================================================
# Plotting
# ==================================================================
fig, axes = plt.subplots(2, 2, figsize=(14, 10))

# Panel A: Best-fit DeltaM per catalog, both models
ax = axes[0,0]
cats = ['Pantheon+', 'Union3', 'DES-Y5']
xs = np.arange(len(cats))
LCDM_dM = [fits_LCDM[c]['DeltaM'] for c in cats]
STAM_dM = [fits_STAM[c]['DeltaM'] for c in cats]
ax.bar(xs - 0.2, LCDM_dM, 0.4, label='LCDM', color='k')
ax.bar(xs + 0.2, STAM_dM, 0.4, label='STAM', color='C1')
ax.axhline(np.mean(LCDM_dM), ls=':', color='gray', alpha=0.5,
           label=f'mean LCDM DeltaM = {np.mean(LCDM_dM):.3f}')
ax.set_xticks(xs); ax.set_xticklabels(cats)
ax.set_ylabel('best-fit DeltaM (mag)')
ax.set_title('Per-catalog calibration offset DeltaM')
ax.legend(loc='best')
ax.grid(alpha=0.3, axis='y')
for i, (lv, sv) in enumerate(zip(LCDM_dM, STAM_dM)):
    ax.text(i-0.2, lv-0.005, f'{lv:.3f}', ha='center', fontsize=9, color='white')
    ax.text(i+0.2, sv-0.005, f'{sv:.3f}', ha='center', fontsize=9, color='white')

# Panel B: observed vs predicted cross-catalog tension
ax = axes[0,1]
labels = [f'{a}\n vs {b}' for a,b in pairs]
obs_vals = [obs_tensions[p] for p in pairs]
pred_vals = [pred_tensions[p] for p in pairs]
xs2 = np.arange(len(pairs))
ax.bar(xs2 - 0.2, obs_vals, 0.4, label='Observed (LCDM-fit DeltaM diff)', color='C0')
ax.bar(xs2 + 0.2, pred_vals, 0.4, label='STAM-predicted', color='C2')
ax.axhline(0, color='gray', alpha=0.5)
ax.set_xticks(xs2); ax.set_xticklabels(labels, fontsize=9)
ax.set_ylabel('DeltaM tension (mag)')
ax.set_title('Cross-catalog DeltaM tension')
ax.legend(loc='best')
ax.grid(alpha=0.3, axis='y')

# Panel C: per-catalog z-distributions
ax = axes[1,0]
ax.hist(zP, bins=60, alpha=0.55, label=f'Pantheon+ (med z={np.median(zP):.2f})', density=True, color='C0')
ax.hist(zU, bins=8, alpha=0.55, label=f'Union3 (med z={np.median(zU):.2f})', density=True, color='C3')
ax.hist(zD, bins=60, alpha=0.55, label=f'DES-Y5 (med z={np.median(zD):.2f})', density=True, color='C2')
ax.set_xlabel('redshift z')
ax.set_ylabel('density')
ax.set_title('z-distributions of the three catalogs')
ax.legend()
ax.grid(alpha=0.3)
ax.set_xlim(0, 2.0)

# Panel D: STAM Delta_mu(z) overplotted with each catalog's <Delta_mu>
ax = axes[1,1]
zg = np.linspace(0.001, 2.0, 400)
dmug = Delta_mu_STAM_minus_LCDM(zg)
ax.plot(zg, dmug, lw=2.5, color='C0', label='Delta_mu(z) = LCDM - STAM')
for cat, color in zip(cats, ['C0','C3','C2']):
    z_med = np.median(eval('z'+cat[0]))
    val = mean_dmu[cat]
    ax.scatter([z_med], [val], s=100, color=color, zorder=10,
               label=f'{cat}: <Delta_mu> = {val:.3f}')
ax.axhline(0, color='gray', alpha=0.5)
ax.set_xlabel('redshift z')
ax.set_ylabel('Delta_mu (mag)')
ax.set_title('STAM Delta_mu(z) and per-catalog weighted means')
ax.legend()
ax.grid(alpha=0.3)

plt.suptitle(
    "Cross-catalog tension test: does STAM predict the observed disagreement?",
    fontsize=13
)
plt.tight_layout(rect=[0, 0, 1, 0.96])

outdir = Path('reports/script_39')
outdir.mkdir(parents=True, exist_ok=True)
plt.savefig(outdir/'catalog_tension_test.png', dpi=130, bbox_inches='tight')
plt.savefig(outdir/'catalog_tension_test.pdf', bbox_inches='tight')

# Save numerical summary
summary = pd.DataFrame([
    {'pair': f'{a} vs {b}', 'observed_mag': obs_tensions[(a,b)],
     'predicted_mag': pred_tensions[(a,b)],
     'ratio_obs_pred': obs_tensions[(a,b)]/pred_tensions[(a,b)]
                       if abs(pred_tensions[(a,b)])>1e-6 else float('nan'),
     'sign_match': obs_tensions[(a,b)]*pred_tensions[(a,b)]>0}
    for a,b in pairs
])
summary.to_csv(outdir/'cross_catalog_summary.csv', index=False)
print(f"\nSaved: {outdir.resolve()}")
print("=" * 72)
